// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js" // Menggunakan provider resmi javascript/typescript
  // Hapus baris 'output = ...' agar hasil generate tersimpan di tempat yang benar
}


datasource db {
  provider = "postgresql"
}

// ==========================================
// 🔐 TABEL WAJIB BETTER AUTH
// ==========================================

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 🔗 Relasi Bisnis Aplikasi Arus
  categories   Category[]    
  transactions Transaction[] 
  sessions     Session[]
  accounts     Account[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Postgres TIDAK membuat indeks otomatis untuk foreign key. Tanpa ini,
  // penghapusan akun memindai seluruh tabel sesi.
  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  selectAccounts        String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// ==========================================
// 💰 TABEL BISNIS APLIKASI ARUS
// ==========================================

model Category {
  id           String        @id @default(uuid())
  name         String        
  type         String        // "INCOME" atau "EXPENSE"
  color        String?       // ✨ BARU: Menyimpan kode warna heksadesimal (misal: #FF5733)
  icon         String?       // ✨ BARU: Menyimpan string nama ikon dari frontend
  createdAt    DateTime      @default(now())
  
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] 

  @@unique([name, type, userId])

  // Halaman /categories dan dropdown "Transaksi Baru" selalu menyaring userId.
  // Indeks unik di atas berawalan `name`, jadi ia tidak bisa melayani kueri ini.
  @@index([userId])
}


model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  type        String   
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId  String
  // ✨ PERBAIKAN: Ganti 'onDelete: Cascade' menjadi 'onDelete: Restrict'
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Tabel terbesar aplikasi ini, dan sebelumnya HANYA punya primary key —
  // setiap kueri memindai seluruh baris milik semua pengguna.
  //
  // Urutan kolom mengikuti bentuk kueri yang benar-benar dipakai:
  //   [userId, createdAt desc] -> daftar transaksi, paginasi, 5 terbaru
  //   [userId, type, createdAt] -> statistik pengeluaran, total per tipe
  //   [categoryId] -> hitung transaksi per kategori & pengalihan saat hapus
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type, createdAt])
  @@index([categoryId])
}

